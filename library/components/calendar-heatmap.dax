-- =============================================================
-- COMPONENT: Calendar heatmap - GitHub style year density strip
-- Why HTML:  NATIVE WORKAROUND EXISTS, richer form. A matrix with
--            conditional-formatting background colors approximates a heat
--            grid, but not the GitHub-style week-column calendar form.
--            AppSource alternatives: OKVIZ ProCalendar Heatmap, Zentrix
--            Calendar Heatmap. This one is pure HTML+CSS grid, so it also
--            works in Secure. Verified against the built-in catalog
--            9 Nov 2026.
-- Binding:   Values  = [HTML Cal Cell]
--            Context = 'Date'[Date]   (one row per day, year filtered)
-- Body template (wraps the rows in the grid):
--   <div class='cal-wrap' dir='rtl' lang='he'>
--     <div class='cal-title'>פיזור הכנסות יומי - 2026</div>
--     <div class='cal-heat' dir='ltr'>{{content}}</div>
--     <div class='cal-legend'><span>נמוך</span><span class='cal-cell cal-c1'></span><span class='cal-cell cal-c2'></span><span class='cal-cell cal-c3'></span><span class='cal-cell cal-c4'></span><span>גבוה</span></div>
--   </div>
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Notes:     the grid is dir=ltr on purpose: weeks flow left to right,
--            chronologically, like every calendar heatmap. The first row
--            emits invisible padding cells so Jan 1 lands on its weekday.
--            title= gives hover text only where the host renders it.
-- Width:     a full-year grid (53 weeks x 13px cell+gap) is ~689px wide.
--            In a narrower frame it clips; give it >= 700px, or filter the
--            Context to a quarter/month for a compact strip.
-- =============================================================

HTML Cal Cell =
VAR D = SELECTEDVALUE ( 'Date'[Date] )
VAR V = [Revenue]   // daily revenue in the row's day context
VAR MaxDay =
    MAXX ( ALLSELECTED ( 'Date'[Date] ), [Revenue] )
VAR Ratio = DIVIDE ( V, MaxDay )
VAR Bin =
    SWITCH (
        TRUE (),
        COALESCE ( V, 0 ) = 0, 0,
        Ratio <= 0.25, 1,
        Ratio <= 0.5, 2,
        Ratio <= 0.75, 3,
        4
    )
VAR MinD = MINX ( ALLSELECTED ( 'Date'[Date] ), 'Date'[Date] )
VAR Offset = MOD ( WEEKDAY ( MinD, 2 ) - 1, 7 )   // Mon=0
VAR PadCells =
    IF ( D = MinD, REPT ( "<span class='cal-cell cal-pad'></span>", Offset ), "" )
RETURN
    PadCells
        & "<span class='cal-cell cal-c" & Bin & "' title='"
            & FORMAT ( D, "dd/mm/yyyy" ) & ": " & FORMAT ( COALESCE ( V, 0 ), "#,##0" )
        & "'></span>"

