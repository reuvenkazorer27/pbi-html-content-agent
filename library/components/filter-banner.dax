-- =============================================================
-- COMPONENT: Filter banner - styled active-filter summary
-- Why HTML:  NATIVE WORKAROUND EXISTS, richer form. A card visual with a
--            dynamic-text measure can print the filter state, and the
--            Filter pane lists selections - but neither renders branded,
--            styled chips inside the canvas design. Read-only: it displays
--            state, it does not change filters.
-- Binding:   Values = [HTML Filter Banner]   (single aggregate)
-- Context:   none.
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Notes:     extend the VAR block per slicer field you expose.
-- =============================================================

HTML Filter Banner =
VAR YrSel =
    IF (
        ISFILTERED ( 'Date'[Year] ),
        CONCATENATEX ( VALUES ( 'Date'[Year] ), 'Date'[Year], ", " ),
        "כל השנים"
    )
VAR CatSel =
    IF (
        ISFILTERED ( Sales[Category] ),
        CONCATENATEX ( VALUES ( Sales[Category] ), Sales[Category], ", " ),
        "כל הקטגוריות"
    )
RETURN
    "<div class='fbanner' dir='rtl' lang='he'>"
        & "<span class='fbanner-cap'>סינון פעיל:</span>"
        & "<span class='fchip'>שנה: " & YrSel & "</span>"
        & "<span class='fchip'>קטגוריה: " & CatSel & "</span>"
    & "</div>"

