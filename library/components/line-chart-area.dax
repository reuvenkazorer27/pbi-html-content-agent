-- .axis-label { font-size:10px; fill:var(--pbi-theme-fg-neutral-secondary,#605E5C);
--            direction:ltr; unicode-bidi:isolate; }
-- .line-path { stroke:var(--pbi-theme-color-1,#0F6CBD); stroke-width:2.5; }
-- .line-end { fill:var(--pbi-theme-color-1,#0F6CBD); }
