-- =============================================================
-- COMPONENT: Bullet chart - actual vs target on qualitative bands
-- Why HTML:  no bullet chart in the Power BI built-in catalog
--            (learn.microsoft.com/power-bi/visuals/power-bi-visualizations-overview);
--            AppSource alternatives: Bullet Chart by OKVIZ, xViz Bullet Chart.
-- Binding:   Values  = [HTML Bullet Row]
--            Context = Sales[Category]   (one row per category)
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Geometry:  RTL - origin at the right edge. Three qualitative bands
--            (65% / 85% / 100% of scale) sit behind a solid actual bar;
--            a tick marks the target. Band fractions are placeholders:
--            bind them to real thresholds from your data when they exist.
--            The svg is fluid (viewBox + width:100%) and the value label is
--            an HTML span, so the digits can never be clipped by the svg
--            bounds when the card is narrower than the design width.
-- Template:  Row template = {{row}}
-- =============================================================

HTML Bullet Row =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR CatName = SELECTEDVALUE ( Sales[Category] )
VAR Val     = [Revenue]
VAR Tgt     = [Revenue Target]
VAR MaxVal  =
    MAXX (
        CALCULATETABLE ( VALUES ( Sales[Category] ), REMOVEFILTERS ( Sales[Category] ) ),
        MAX ( [Revenue], [Revenue Target] )
    )
VAR W = 380   // logical viewBox width; rendered width is fluid
VAR H = 34
VAR Pad = 4    // keeps the target tick off the svg edges
VAR SW = W - 2 * Pad
VAR Band1 = INT ( SW * 0.65 )   // good zone edge
VAR Band2 = INT ( SW * 0.85 )   // ok zone edge
VAR BarW  = INT ( SW * DIVIDE ( Val, MaxVal ) )
VAR TgtX  = W - Pad - INT ( SW * DIVIDE ( Tgt, MaxVal ) )   // marker, from the right edge
RETURN
    "<div class='bullet-row' dir='rtl' lang='he'>"
        & "<span class='bullet-label'>" & CatName & "</span>"
        & "<span class='bl-plot'>"
            & "<svg viewBox='0 0 " & W & " " & H & "' preserveAspectRatio='xMidYMid meet'>"
                & "<rect x='" & W - Pad - SW & "' y='7' width='" & SW & "' height='20' rx='3' class='bl-band3'/>"
                & "<rect x='" & W - Pad - Band2 & "' y='7' width='" & Band2 & "' height='20' rx='3' class='bl-band2'/>"
                & "<rect x='" & W - Pad - Band1 & "' y='7' width='" & Band1 & "' height='20' rx='3' class='bl-band1'/>"
                & "<rect x='" & W - Pad - BarW & "' y='12' width='" & BarW & "' height='10' rx='2' class='bl-fill'/>"
                & "<line x1='" & TgtX & "' y1='3' x2='" & TgtX & "' y2='31' class='bl-marker'/>"
            & "</svg>"
        & "</span>"
        & "<span class='bl-value'>" & LRI & FORMAT ( Val, "#,##0" ) & PDI & "</span>"
    & "</div>"

-- STYLESHEET:
