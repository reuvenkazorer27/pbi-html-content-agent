-- =============================================================
-- COMPONENT: Data table (RTL Hebrew) - templates-based
-- Layer:     foundation - the default for every table/matrix this agent builds (AGENTS.md: 'What this agent is built on'); the built-in table/matrix is not used.
-- Binding:   Values  = [HTML Table Row]
--            Context = Sales[Category]
-- Templates: Body template and Row template below (paste into the
--            visual's Templates card, or bind via fx).
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Filters:   rows cross-filter after Cross-filtering > Enable; right-click
--            gives drillthrough when a drillthrough page exists.
-- Blank rows: return BLANK() from the row measure to drop a row entirely.
-- Narrow:   the visual frame does not shrink a table below its min-content width;
--           use the "HTML Table Row (narrow)" measure below in narrow visuals.
-- =============================================================

-- ----- Body template (property, not a measure) -----
-- <table dir='rtl' class='data-table'>
--   <thead><tr>
--     <th>קטגוריה</th><th class='num'>הכנסות</th><th class='num'>יעד</th><th class='num'>השלמה</th>
--   </tr></thead>
--   <tbody>{{content}}</tbody>
-- </table>

-- ----- Row template (property) -----
-- <tr>{{row}}</tr>

-- ----- Row measure (one <td> set per Context row) -----
HTML Table Row =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR Pct = DIVIDE ( [Revenue], [Revenue Target] )
VAR State = IF ( Pct >= 1, "good", IF ( Pct >= 0.75, "warn", "bad" ) )
RETURN
    "<td>" & SELECTEDVALUE ( Sales[Category] ) & "</td>"
    & "<td class='num'>" & LRI & FORMAT ( [Revenue], "#,##0" ) & " ₪" & PDI & "</td>"
    & "<td class='num'>" & LRI & FORMAT ( [Revenue Target], "#,##0" ) & " ₪" & PDI & "</td>"
    & "<td class='num'><span class='pill " & State & "'>" & LRI & FORMAT ( Pct, "0%" ) & PDI & "</span></td>"

-- ----- Narrow variant (mobile / card visuals under ~340 px) -----
-- Same binding; compact row measure + slim cells: millions shorten to "3.2M ₪"
-- so 4 columns fit a narrow frame without cropping or mid-number wraps.
-- Body template for the narrow visual:
-- <table dir='rtl' class='data-table narrow'>
--   <thead><tr>
--     <th>קטגוריה</th><th class='num'>הכנסות</th><th class='num'>יעד</th><th class='num'>השלמה</th>
--   </tr></thead>
--   <tbody>{{content}}</tbody>
-- </table>

HTML Table Row (narrow) =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR Pct = DIVIDE ( [Revenue], [Revenue Target] )
VAR State = IF ( Pct >= 1, "good", IF ( Pct >= 0.75, "warn", "bad" ) )
VAR FmtM =
    IF ( ABS ( [Revenue] ) >= 1000000,
        LRI & FORMAT ( [Revenue] / 1000000, "0.0" ) & "M" & UNICHAR ( 160 ) & "₪" & PDI,
        LRI & FORMAT ( [Revenue], "#,##0" ) & " ₪" & PDI )
VAR FmtMT =
    IF ( ABS ( [Revenue Target] ) >= 1000000,
        LRI & FORMAT ( [Revenue Target] / 1000000, "0.0" ) & "M" & UNICHAR ( 160 ) & "₪" & PDI,
        LRI & FORMAT ( [Revenue Target], "#,##0" ) & " ₪" & PDI )
RETURN
    "<td>" & SELECTEDVALUE ( Sales[Category] ) & "</td>"
    & "<td class='num'>" & FmtM & "</td>"
    & "<td class='num'>" & FmtMT & "</td>"
    & "<td class='num'><span class='pill " & State & "'>" & LRI & FORMAT ( Pct, "0%" ) & PDI & "</span></td>"

