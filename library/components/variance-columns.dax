-- .var-ac { fill:var(--pbi-theme-fg,#323130); }                 /* actual: solid dark (IBCS) */
-- .var-pl { fill:none; stroke:var(--pbi-theme-fg,#323130); stroke-width:1.5; }  /* plan: outline */
-- .var-delta.up   { fill:var(--pbi-theme-good,#107C10); }
-- .var-delta.down { fill:var(--pbi-theme-bad,#D13438); }
-- .var-base { stroke:var(--pbi-theme-fg-neutral-secondary,#8A8886); stroke-width:1; }
-- .var-pct { font-size:12px; font-weight:600; direction:ltr; unicode-bidi:isolate; }
-- .var-pct.up   { fill:var(--pbi-theme-good,#107C10); }
-- .var-pct.down { fill:var(--pbi-theme-bad,#D13438); }
