-- =============================================================
-- COMPONENT: Stage tracker - operational pipeline status strip
-- Why HTML:  no native status-stepper layout. The built-in Funnel shows
--            descending values as bars; it does not render a connected
--            stage flow with per-stage counts, conversion badges on the
--            connectors, and stage status colors. Verified against the
--            built-in catalog 9 Nov 2026.
-- Layer:     differentiation
-- Binding:   Values = [HTML Stage Tracker]   (single aggregate)
-- Context:   none. Incoming filters apply.
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Notes:     stage measures here are placeholders ([Orders] family) -
--            replace with your pipeline measures. First stage renders on
--            the right in RTL; connector badges carry the conversion %.
-- =============================================================

HTML Stage Tracker =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR S1 = [Orders]
VAR S2 = [Orders Shipped]
VAR S3 = [Orders Delivered]
VAR S4 = [Orders Paid]
VAR C1 = LRI & FORMAT ( DIVIDE ( S2, S1 ), "0%" ) & PDI
VAR C2 = LRI & FORMAT ( DIVIDE ( S3, S2 ), "0%" ) & PDI
VAR C3 = LRI & FORMAT ( DIVIDE ( S4, S3 ), "0%" ) & PDI
VAR F1 = LRI & FORMAT ( S1, "#,0" ) & PDI
VAR F2 = LRI & FORMAT ( S2, "#,0" ) & PDI
VAR F3 = LRI & FORMAT ( S3, "#,0" ) & PDI
VAR F4 = LRI & FORMAT ( S4, "#,0" ) & PDI
VAR Step =
    LAMBDA ( nm, val, st,
        "<div class='stg " & st & "'><span class='stg-circle'></span>"
            & "<span class='stg-name'>" & nm & "</span>"
            & "<span class='stg-val'>" & val & "</span></div>"
    )
VAR Conn =
    LAMBDA ( cv,
        "<div class='stg-conn'><span class='stg-line'></span>"
            & "<span class='stg-conv'>" & cv & "</span></div>"
    )
RETURN
    "<div class='stg-flow' dir='rtl' lang='he'>"
        & Step ( "התקבלו", F1, "done" )
        & Conn ( C1 )
        & Step ( "נשלחו", F2, "done" )
        & Conn ( C2 )
        & Step ( "סופקו", F3, "active" )
        & Conn ( C3 )
        & Step ( "שולמו", F4, "todo" )
    & "</div>"

