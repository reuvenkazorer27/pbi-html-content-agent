-- =============================================================
-- COMPONENT: KPI card with icon chip and delta pill (RTL Hebrew)
-- Layer:     foundation - the agent's default for this region (everything except slicers is HTML Content, AGENTS.md 'What this agent is built on').
-- Binding:   Values = [HTML KPI - Icon]
-- Context:   none
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Compose:   the icon chip is a tiny inline SVG - swap the rects for any
--            3-bar glyph, or replace with a unicode glyph like the side menu.
-- =============================================================

HTML KPI - Icon =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR CurrentRevenue = [Revenue]
VAR LastYear = [Revenue LY]
VAR Delta = DIVIDE ( CurrentRevenue - LastYear, LastYear )
VAR DirClass = IF ( Delta >= 0, "up", "down" )
VAR Arrow = IF ( Delta >= 0, "▲", "▼" )
RETURN
    "<div class='kpi' dir='rtl' lang='he'>"
        & "<div class='kpi-top'>"
            & "<span class='kpi-ico'>"
                & "<svg width='18' height='18' viewBox='0 0 18 18'>"
                    & "<rect x='1' y='9' width='4' height='8' rx='1' class='ico-bar'/>"
                    & "<rect x='7' y='5' width='4' height='12' rx='1' class='ico-bar'/>"
                    & "<rect x='13' y='1' width='4' height='16' rx='1' class='ico-bar'/>"
                & "</svg>"
            & "</span>"
            & "<span class='kpi-title'>הכנסות</span>"
        & "</div>"
        & "<div class='kpi-value'>" & LRI & FORMAT ( CurrentRevenue, "#,##0" ) & " ₪" & PDI & "</div>"
        & "<div><span class='kpi-pill " & DirClass & "'>"
            & LRI & Arrow & " " & FORMAT ( ABS ( Delta ), "0.0%" ) & PDI
            & " מול שנה קודמת</span></div>"
    & "</div>"

