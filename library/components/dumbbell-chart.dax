-- =============================================================
-- COMPONENT: Dumbbell chart - two periods compared per category
-- Why HTML:  no dumbbell chart in the built-in catalog; AppSource
--            alternatives: Dumbbell Chart by MAQ Software, Dumbbell
--            Bar/Column Chart. Shows direction and magnitude of change
--            between two periods better than two bar series.
-- Binding:   Values  = [HTML Dumbbell Row]
--            Context = Sales[Category]   (one row per category)
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Geometry:  RTL - origin at the right edge. Gray dot = last year,
--            accent dot = this year, connecting line. The signed delta
--            label is an HTML span, NOT svg text: the svg is fluid
--            (viewBox + width:100%) so it can shrink to any card width,
--            and an HTML label can never be clipped by the svg bounds.
-- Template:  Row template = {{row}}
-- =============================================================

HTML Dumbbell Row =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR CatName = SELECTEDVALUE ( Sales[Category] )
VAR Val     = [Revenue]
VAR ValLY   = [Revenue LY]
VAR MaxVal  =
    MAXX (
        CALCULATETABLE ( VALUES ( Sales[Category] ), REMOVEFILTERS ( Sales[Category] ) ),
        MAX ( [Revenue], [Revenue LY] )
    )
VAR DeltaPct = DIVIDE ( Val - ValLY, ValLY )
VAR W = 380          // logical viewBox width; rendered width is fluid
VAR Pad = 8          // keeps dots off the svg edges
VAR SW = W - 2 * Pad
VAR MidY = 12
VAR XNow = W - Pad - INT ( SW * DIVIDE ( Val, MaxVal ) )
VAR XLY  = W - Pad - INT ( SW * DIVIDE ( ValLY, MaxVal ) )
VAR UpCls = IF ( Val >= ValLY, "up", "down" )
RETURN
    "<div class='dbb-row' dir='rtl' lang='he'>"
        & "<span class='dbb-label'>" & CatName & "</span>"
        & "<span class='dbb-plot'>"
            & "<svg viewBox='0 0 " & W & " 24' preserveAspectRatio='xMidYMid meet'>"
                & "<line x1='" & XLY & "' y1='" & MidY & "' x2='" & XNow & "' y2='" & MidY & "' class='dbb-link " & UpCls & "'/>"
                & "<circle cx='" & XLY & "' cy='" & MidY & "' r='5' class='dbb-ly'/>"
                & "<circle cx='" & XNow & "' cy='" & MidY & "' r='6' class='dbb-now'/>"
            & "</svg>"
        & "</span>"
        & "<span class='dbb-delta " & UpCls & "'>"
            & LRI & FORMAT ( DeltaPct, "+0%;-0%" ) & PDI
        & "</span>"
    & "</div>"},{

