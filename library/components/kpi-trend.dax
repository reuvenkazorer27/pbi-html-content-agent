-- =============================================================
-- COMPONENT: KPI trend card - value + sparkline + dual comparison pills
-- Why HTML:  NATIVE EXISTS, richer composition. The modern Card visual
--            (power-bi-visualization-card) covers value + reference labels
--            + images + layouts, but cannot embed a sparkline inside the
--            card (native sparklines exist only in table/matrix). This
--            composition - sparkline + YoY pill + target pill + status
--            accent edge in one tight card - is the top-of-dashboard KPI
--            row component. Verified 9 Nov 2026.
-- Binding:   Values = [HTML KPI Trend - Revenue]   (single aggregate)
-- Context:   none. Incoming filters apply.
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Requires:  a marked date table 'Date' with 'Date'[Month start].
-- =============================================================

HTML KPI Trend - Revenue =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR Val    = [Revenue]
VAR ValLY  = [Revenue LY]
VAR YoYPct  = DIVIDE ( Val - ValLY, ValLY )
VAR AttPct  = DIVIDE ( Val, [Revenue Target] )
VAR YoYCls  = IF ( YoYPct >= 0, "up", "down" )
VAR Arrow   = IF ( YoYPct >= 0, "▲", "▼" )
VAR AttCls  = IF ( AttPct >= 1, "up", IF ( AttPct >= 0.9, "warn", "down" ) )
VAR Status  = IF ( AttPct >= 1, "good", IF ( AttPct >= 0.9, "warn", "bad" ) )
-- sparkline geometry
VAR W = 150
VAR H = 36
VAR Pad = 2
VAR Periods = FILTER ( VALUES ( 'Date'[Month start] ), NOT ISBLANK ( [Revenue] ) )
VAR N      = COUNTROWS ( Periods )
VAR MinV   = MINX ( Periods, [Revenue] )
VAR MaxV   = MAXX ( Periods, [Revenue] )
VAR RangeV = MAX ( MaxV - MinV, 1 )
VAR Points =
    CONCATENATEX (
        Periods,
        VAR i = RANKX ( Periods, 'Date'[Month start], , ASC ) - 1
        VAR x = Pad + i * DIVIDE ( W - 2 * Pad, MAX ( N - 1, 1 ) )
        VAR y = H - Pad - DIVIDE ( [Revenue] - MinV, RangeV ) * ( H - 2 * Pad )
        RETURN FORMAT ( x, "0.0" ) & "," & FORMAT ( y, "0.0" ),
        " ",
        'Date'[Month start], ASC
    )
RETURN
    "<div class='ktrend " & Status & "' dir='rtl' lang='he'>"
        & "<div class='ktrend-head'>"
            & "<span class='ktrend-title'>הכנסות</span>"
            & "<svg class='ktrend-spark' width='" & W & "' height='" & H & "' viewBox='0 0 " & W & " " & H & "'>"
                & "<polyline points='" & Points & "' fill='none' class='spark-line'/>"
            & "</svg>"
        & "</div>"
        & "<div class='ktrend-value'>" & LRI & FORMAT ( Val, "#,##0" ) & " ₪" & PDI & "</div>"
        & "<div class='ktrend-pills'>"
            & "<span class='pill sm " & YoYCls & "'>"
                & LRI & Arrow & " " & FORMAT ( ABS ( YoYPct ), "0.0%" ) & PDI & " מול שנה קודמת</span>"
            & "<span class='pill sm " & AttCls & "'>"
                & LRI & FORMAT ( AttPct, "0%" ) & PDI & " מהיעד</span>"
        & "</div>"
    & "</div>"

