-- =============================================================
-- COMPONENT: Side menu (RTL, right-docked) - display + overlay navigation
-- Layer:     shell - page furniture (header/menu/chips); native text/buttons/navigators exist but cannot carry this styling and live values.
-- Binding:   Values = [HTML Side Menu]   (set ActivePage per page)
-- Context:   none. The menu does NOT cross-filter.
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Navigation: HTML menu items are NOT clickable navigation. Place a native
--            blank button (100% transparent, no border) over each item
--            rectangle with Action = Page navigation.
--            See skills/navigation-header-menu/SKILL.md for the overlay spec.
-- Sizing:    width 200px at 720p, docked right: x = 1280 - 24 - 200 = 1056.
-- =============================================================

HTML Side Menu =
VAR ActivePage = "sales"     -- set per page copy: "sales" | "products" | "customers" | "targets"
VAR ClassSales     = IF ( ActivePage = "sales",     "menu-item active", "menu-item" )
VAR ClassProducts  = IF ( ActivePage = "products",  "menu-item active", "menu-item" )
VAR ClassCustomers = IF ( ActivePage = "customers", "menu-item active", "menu-item" )
VAR ClassTargets   = IF ( ActivePage = "targets",   "menu-item active", "menu-item" )
VAR ClassBudget    = IF ( ActivePage = "budget",    "menu-item active", "menu-item" )
VAR ClassReports   = IF ( ActivePage = "reports",   "menu-item active", "menu-item" )
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR OrdersTxt = LRI & FORMAT ( [Orders], "#,0" ) & PDI
VAR AttTxt = LRI & FORMAT ( DIVIDE ( [Revenue], [Revenue Target] ), "0%" ) & PDI
RETURN
    "<nav class='side-menu' dir='rtl' lang='he'>"
        & "<div class='menu-brand'>Data &amp; AI</div>"
        & "<div class='" & ClassSales     & "' data-page='sales'>"
            & "<span class='menu-ico'>◧</span><span>מכירות</span></div>"
        & "<div class='" & ClassProducts  & "' data-page='products'>"
            & "<span class='menu-ico'>◫</span><span>מוצרים</span></div>"
        & "<div class='" & ClassCustomers & "' data-page='customers'>"
            & "<span class='menu-ico'>◉</span><span>לקוחות</span></div>"
        & "<div class='" & ClassTargets   & "' data-page='targets'>"
            & "<span class='menu-ico'>◎</span><span>יעדים</span></div>"
        & "<div class='" & ClassBudget    & "' data-page='budget'>"
            & "<span class='menu-ico'>▤</span><span>תקציב</span></div>"
        & "<div class='" & ClassReports   & "' data-page='reports'>"
            & "<span class='menu-ico'>▦</span><span>דוחות</span></div>"
        & "<div class='menu-sec'>מבט מהיר</div>"
        & "<div class='menu-quick'><span>הזמנות</span><b>" & OrdersTxt & "</b></div>"
        & "<div class='menu-quick'><span>השגת יעד</span><b>" & AttTxt & "</b></div>"
        & "<div class='menu-foot'>גרסה " & UNICHAR ( 8294 ) & "1.0" & UNICHAR ( 8297 ) & "</div>"
    & "</nav>"

