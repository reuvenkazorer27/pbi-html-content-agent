-- =============================================================
-- COMPONENT: Semicircle gauge (RTL Hebrew)
-- Layer:     foundation - the agent's default for this region (everything except slicers is HTML Content, AGENTS.md 'What this agent is built on').
-- Binding:   Values = [HTML Gauge - Attainment]
-- Context:   none
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Geometry:  semicircle r=80, arc length = PI()*80 = 251.33.
--            Fills left-to-right (gauges conventionally read LTR);
--            flip x coordinates if a right-anchored gauge is wanted.
-- =============================================================

HTML Gauge - Attainment =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR Pct   = DIVIDE ( [Revenue], [Revenue Target] )
VAR Shown = MIN ( MAX ( Pct, 0 ), 1 )
VAR ArcLen = PI () * 80
VAR Dash = ArcLen * Shown
VAR State = IF ( Pct >= 1, "good", IF ( Pct >= 0.75, "warn", "bad" ) )
RETURN
    "<div class='gauge-card' dir='rtl' lang='he'>"
        & "<div class='gauge-title'>השגת יעד שנתי</div>"
        & "<svg width='200' height='120' viewBox='0 0 200 120'>"
            & "<path d='M 20 100 A 80 80 0 0 1 180 100' class='gauge-track'/>"
            & "<path d='M 20 100 A 80 80 0 0 1 180 100' class='gauge-fill " & State & "' "
                & "stroke-dasharray='" & FORMAT ( Dash, "0.0" ) & " " & FORMAT ( ArcLen, "0.0" ) & "'/>"
            & "<text x='100' y='92' text-anchor='middle' class='gauge-value'>"
                & LRI & FORMAT ( Pct, "0%" ) & PDI
            & "</text>"
        & "</svg>"
        & "<div class='gauge-sub'>"
            & LRI & FORMAT ( [Revenue], "#,##0" ) & " ₪" & PDI & " מתוך "
            & LRI & FORMAT ( [Revenue Target], "#,##0" ) & " ₪" & PDI
        & "</div>"
    & "</div>"

