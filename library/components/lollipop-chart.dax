-- =============================================================
-- COMPONENT: Lollipop chart - light alternative to bars
-- Why HTML:  no lollipop chart in the built-in catalog. Lower ink than a
--            bar chart, so dense category lists stay readable; the value
--            dot can carry status color vs target in the same row.
-- Binding:   Values  = [HTML Lollipop Row]
--            Context = Sales[Category]   (one row per category)
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Geometry:  RTL - stem grows from the right edge; the dot marks the value.
--            The svg is fluid (viewBox + width:100%) and the value label is
--            an HTML span, so neither dots nor digits can be clipped by the
--            svg bounds when the card is narrower than the design width.
-- Template:  Row template = {{row}}
-- =============================================================

HTML Lollipop Row =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR CatName = SELECTEDVALUE ( Sales[Category] )
VAR Val = [Revenue]
VAR MaxVal =
    MAXX (
        CALCULATETABLE ( VALUES ( Sales[Category] ), REMOVEFILTERS ( Sales[Category] ) ),
        [Revenue]
    )
VAR AttPct = DIVIDE ( Val, [Revenue Target] )
VAR DotCls = IF ( AttPct >= 1, "good", IF ( AttPct >= 0.9, "warn", "bad" ) )
VAR W = 380          // logical viewBox width; rendered width is fluid
VAR Pad = 6          // keeps the dot off the svg edges
VAR SW = W - 2 * Pad
VAR DotX = W - Pad - INT ( SW * DIVIDE ( Val, MaxVal ) )
VAR MidY = 14
RETURN
    "<div class='loli-row' dir='rtl' lang='he'>"
        & "<span class='loli-label'>" & CatName & "</span>"
        & "<span class='loli-plot'>"
            & "<svg viewBox='0 0 " & W & " 28' preserveAspectRatio='xMidYMid meet'>"
                & "<line x1='" & W - Pad & "' y1='" & MidY & "' x2='" & DotX & "' y2='" & MidY & "' class='loli-stem'/>"
                & "<circle cx='" & DotX & "' cy='" & MidY & "' r='6' class='loli-dot " & DotCls & "'/>"
            & "</svg>"
        & "</span>"
        & "<span class='loli-value'>" & LRI & FORMAT ( Val, "#,##0" ) & PDI & "</span>"
    & "</div>"

