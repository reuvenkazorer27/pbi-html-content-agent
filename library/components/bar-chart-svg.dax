-- =============================================================
-- COMPONENT: Horizontal bar rows (RTL Hebrew) - one row per category
-- Layer:     foundation - a built-in alternative exists; prefer the native visual in composite mode, use this in fullscreen shell mode or when its exact styling is the point.
-- Binding:   Values  = [HTML Bar Row]
--            Context = Sales[Category]   (one row per category)
-- Edition:   Regular + Secure
-- Status:    doc-based (HTML Content 2.0), NOT run in Power BI
-- Filters:   incoming always; outgoing after enabling
--            Format pane > Cross-filtering > Enable (needs the Context column).
-- RTL:       bars anchored right (x = W - BarW). The svg is fluid (viewBox
--            + width:100%) and the value label is an HTML span, so the digits
--            can never be clipped by the svg bounds on narrow cards.
-- Template:  Row template = {{row}}  (the measure returns the row's root element)
-- =============================================================

HTML Bar Row =
VAR LRI = UNICHAR ( 8294 )
VAR PDI = UNICHAR ( 8297 )
VAR CatName = SELECTEDVALUE ( Sales[Category] )
VAR Val     = [Revenue]
VAR MaxVal  =
    MAXX (
        CALCULATETABLE ( VALUES ( Sales[Category] ), REMOVEFILTERS ( Sales[Category] ) ),
        [Revenue]
    )
VAR W = 380   // logical viewBox width; rendered width is fluid
VAR H = 28
VAR Pad = 4    // keeps the bar tip off the svg edge
VAR SW = W - 2 * Pad
VAR BarW = INT ( SW * DIVIDE ( Val, MaxVal ) )
RETURN
    "<div class='bar-row' dir='rtl' lang='he'>"
        & "<span class='bar-label'>" & CatName & "</span>"
        & "<span class='bar-plot'>"
            & "<svg viewBox='0 0 " & W & " " & H & "' preserveAspectRatio='xMidYMid meet'>"
                & "<rect x='" & Pad & "' y='4' width='" & SW & "' height='20' rx='4' class='bar-track'/>"
                & "<rect x='" & W - Pad - BarW & "' y='4' width='" & BarW & "' height='20' rx='4' class='bar-fill'/>"
            & "</svg>"
        & "</span>"
        & "<span class='bar-value'>" & LRI & FORMAT ( Val, "#,##0" ) & PDI & "</span>"
    & "</div>"

